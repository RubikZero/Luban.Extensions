<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Luban.ScriptValidator</AssemblyName>
    <RootNamespace>Luban.ScriptValidator</RootNamespace>
    <IsLubanExtension>true</IsLubanExtension>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\tools\Luban.Extension.Deployer\Luban.Extension.Deployer.csproj"
                      ReferenceOutputAssembly="false" />

    <PackageReference Include="MoonSharp.Interpreter.netcore" Version="2.0.0" />

    <Reference Include="Luban.Core">
      <HintPath>$(LubanDir)\Luban.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NLog">
      <HintPath>$(LubanDir)\NLog.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Luban.TemplateExtensions.TypeTemplateExtension derives from Scriban's
         ScriptObject, so the ref-model helpers need Scriban at compile time.
         It ships with Luban, so it is never deployed with the extension. -->
    <Reference Include="Scriban">
      <HintPath>$(LubanDir)\Scriban.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- The deployer copies this managed runtime alongside the extension. -->
    <LubanExtensionDependency Include="$(TargetDir)MoonSharp.Interpreter.dll" />
  </ItemGroup>

</Project>
