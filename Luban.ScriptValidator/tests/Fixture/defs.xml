<module name="test">
    <bean name="Row">
        <var name="id" type="int"/>
        <var name="kind" type="string"/>
        <var name="level" type="int"/>
        <var name="name" type="string"/>
    </bean>

    <!-- single-field primary key -->
    <table name="TbSingle" value="Row" index="id" mode="map" input="single.csv"/>

    <!-- several independent keys, each unique on its own -->
    <table name="TbMulti" value="Row" index="id,name" mode="list" input="multi.csv"/>

    <!-- one union key: only the combination is unique -->
    <table name="TbUnion" value="Row" index="kind+level" mode="list" input="union.csv"/>

    <!-- singleton -->
    <table name="TbOne" value="Row" mode="one" input="one.csv"/>

    <!-- A field carrying validator tags, so the path validator and a column rule
         take part in the same run. Tags live in the type string: "assets/sword.txt"
         has to exist under one of the configured root directories, and "iconName"
         is a rule registered by the column scripts. -->
    <bean name="Asset">
        <var name="id" type="int"/>
        <var name="icon" type="string#path=normal;assets/*.txt#lua=iconName"/>
    </bean>

    <table name="TbAsset" value="Asset" index="id" mode="map" input="asset.csv"/>

    <!-- A column rule declared inside a bean, so it applies wherever the bean is
         used. The rule has to read a sibling field to know which table holds the
         id, which is what the owner argument is for. -->
    <enum name="UnitType">
        <var name="Hero" value="1"/>
        <var name="Monster" value="2"/>
    </enum>

    <bean name="UnitInfo" sep=",">
        <var name="unit_type" type="UnitType"/>
        <var name="unit_id" type="int#lua=unitRef"/>
        <var name="unit_count" type="int"/>
    </bean>

    <!-- Two tables using the bean, with different field names: the rule is declared
         once and has to work in both places. -->
    <bean name="UnitRow">
        <var name="id" type="int"/>
        <var name="unit" type="UnitInfo"/>
    </bean>

    <bean name="SquadRow">
        <var name="id" type="int"/>
        <var name="squad" type="UnitInfo"/>
    </bean>

    <!-- The tables the rule above checks against. -->
    <table name="TbHero" value="Row" index="id" mode="map" input="hero.csv"/>
    <table name="TbMonster" value="Row" index="id" mode="map" input="monster.csv"/>
    <table name="TbUnit" value="UnitRow" index="id" mode="map" input="unit.csv"/>
    <table name="TbSquad" value="SquadRow" index="id" mode="map" input="squad.csv"/>

    <!-- A tag on a container field lands on the element type, so these rules run
         once per element with the element as their value. The container part of
         the spelling carries the data separator, which is what lets the loader
         split the cell at all. -->
    <bean name="Member" sep=",">
        <var name="member_type" type="UnitType"/>
        <var name="member_id" type="int"/>
    </bean>

    <bean name="Roster">
        <var name="id" type="int"/>
        <!-- a tag inside the container's parentheses lands on the container: one
             call per record with the whole list; a tag after the element type lands
             on the element: one call per element -->
        <var name="weights" type="(list#sep=,#lua=wholeRule),int#lua=weightRule"/>
        <!-- element-tagged bean: one call per Member -->
        <var name="scores" type="(list#sep=;),Member#lua=memberRule"/>
        <!-- no element tag: the rule declared inside UnitInfo still runs once per
             element, which is how a list of tagged beans is validated -->
        <var name="members" type="(list#sep=;),UnitInfo"/>
    </bean>

    <table name="TbRoster" value="Roster" index="id" mode="map" input="roster.csv"/>
</module>
